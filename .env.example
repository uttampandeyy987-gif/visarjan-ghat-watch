# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings → Environment Variables (server-side only).

# Optional. Enables "Draft with Claude" explanations. Without it the app shows a
# deterministic automatic summary and everything else works.
# Must NOT be prefixed with NEXT_PUBLIC_ — it is read only on the server.
ANTHROPIC_API_KEY=

# Optional. Model used for explanations. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Optional abuse/cost limits for /api/explain (per server instance).
AI_RATE_PER_MINUTE=4
AI_RATE_PER_DAY=30
AI_DAILY_CAP=300
